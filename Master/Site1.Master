<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="SEARCHJOBSHEEKERMay16_26.Site1" %>

<%@ Register Src="~/Master/Header.ascx" TagName="myHeader" TagPrefix="asp" %>
<%@ Register Src="~/Master/Fotter.ascx" TagName="myFotter" TagPrefix="asp" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Job Portal Management</title>

    <!-- Bootstrap 4.5 & FontAwesome for Modern UI -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css" />

    <%-- Purane Assets (agar zarurat ho toh ResolveUrl ke saath) --%>
    <script src='<%= ResolveUrl("~/Master/jquery.js") %>'></script>
    <link href='<%= ResolveUrl("~/Master/menu.css") %>' rel="stylesheet" />
    <script src='<%= ResolveUrl("~/Master/menu.js") %>'></script>

    <style>
        body {
            background-color: #f4f7f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-main {
            background-color: #0d47a1; /* Deep Professional Blue */
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            padding: 15px 0;
        }

        .navbar-brand {
            font-weight: 700;
            color: #fff !important;
            letter-spacing: 1px;
        }

        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 500;
            margin-right: 15px;
            transition: 0.3s;
            padding: 8px 15px !important;
        }

            .nav-link:hover {
                color: #fff !important;
                transform: translateY(-1px);
            }

        .dropdown-menu {
            border-radius: 10px;
            border: none;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

        .dropdown-item:hover {
            background-color: #0d47a1;
            color: white;
        }

        .main-wrapper {
            flex: 1;
            padding: 40px 0;
        }

        .content-container {
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            min-height: 500px;
            padding: 30px;
            border: 1px solid #eef2f6;
        }

        .nav-icon {
            margin-right: 6px;
        }

        footer {
            margin-top: auto;
            background: #fff;
            border-top: 1px solid #e2e8f0;
            padding: 20px 0;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Top Header Component -->
        <header>
            <asp:myHeader ID="myHeader1" runat="server" />
        </header>

        <!-- Responsive Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-dark navbar-main sticky-top">
            <div class="container">
                <a class="navbar-brand" href="#">
                    <i class="fas fa-briefcase nav-icon"></i>JOB PORTAL
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mr-auto">
                        <!-- Registration Dropdown Group -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="regDrop" data-toggle="dropdown">
                                <i class="fas fa-user-plus nav-icon"></i>Registration
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" href='<%= ResolveUrl("~/Admin/Registration_Jobsheeker.aspx") %>'>JobSeeker Join</a>
                                <a class="dropdown-item" href='<%= ResolveUrl("~/Admin/Registration_JobRecruiter.aspx.aspx") %>'>JobRecruiter Join</a>
                            </div>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href='<%= ResolveUrl("~/Admin/FullIPresonalCRUD.aspx") %>'>
                                <i class="fas fa-id-card nav-icon"></i>Personal Info
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href='<%= ResolveUrl("~/Admin/PrashantInformation.aspx") %>'>
                                <i class="fas fa-external-link-alt nav-icon"></i>External
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-light px-4" href='<%= ResolveUrl("../Login.aspx") %>'>
                                <i class="fas fa-sign-in-alt nav-icon"></i>Login
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Dynamic Content Section -->
        <main class="main-wrapper">
            <div class="container">
                <div class="content-container">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </main>

        <!-- Footer Component -->
        <footer>
            <div class="container">
                <asp:myFotter ID="myFotter1" runat="server" />
            </div>
        </footer>

    </form>

    <!-- Bootstrap & JS Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
